  autoGenerated   Boolean   @default(false)

  @@map("demo_settings")
}

// ── UGC module ────────────────────────────────────────────────────────────────
// Native extension of the Affiliate System. Fully additive: new tables only, no
// change to any existing table's columns or data. UGC accounting (UgcEarning) and
// audit history (UgcVideoHistory) are append-only ledgers — every FK uses
// onDelete: Restrict so these records can NEVER disappear because an affiliate,
// product, or submission was removed. The application exposes no deletion flow for
// submissions, history, or earnings.
//
// DELETION MODEL (assumption behind the RESTRICT foreign keys):
//   Products and Affiliates that are referenced by UGC records are expected to be
//   ARCHIVED (soft-deleted / isActive=false), NOT physically deleted. A hard
//   delete of such a row is intentionally blocked by these RESTRICT FKs (Postgres
//   raises a foreign-key violation) so that UGC earnings and audit history are
//   never orphaned or lost. Preserving records is preferred over cascading them
//   away. Callers that need to "remove" a UGC-referenced product/affiliate must
//   archive it rather than delete it.
//
// MONETARY PRECISION:
//   All UGC money is Decimal(18,2) (NUMERIC). Every UGC calculation — including
//   the balance term added to the affiliate balance — stays in Prisma.Decimal
//   from the database aggregate through to the final serialization boundary. No
//   Decimal -> Number -> Decimal round-trips.

enum UgcStatus {
  PENDING
  APPROVED
  RUNNING
  PAUSED
  REJECTED
}

// One affiliate + one product = exactly one submission (enforced by @@unique).
// A rejected submission is REPLACED in place (video swapped, status → PENDING),
// never re-created — full history is kept in UgcVideoHistory.
model UgcVideoSubmission {
  id                   String    @id @default(uuid())
  affiliateId          String
  productId            String
  videoUrl             String
  storageKey           String?
  description          String?
  status               UgcStatus @default(PENDING)
  advertisingConsent   Boolean   @default(false)
  advertisingConsentAt DateTime?
  submittedAt          DateTime  @default(now())
  approvedAt           DateTime?
  rejectedAt           DateTime?
  pausedAt             DateTime?
  resumedAt            DateTime?
  rejectionReason      String?
  internalAdminNotes   String? // ADMIN-ONLY — never serialized to affiliate responses
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  affiliate Affiliate         @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  product   Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  histories UgcVideoHistory[]
  earnings  UgcEarning[]
  dailyTargets UgcDailyTarget[]

  @@unique([affiliateId, productId])
  @@index([affiliateId])
  @@index([productId])
  @@index([status])
  @@index([createdAt])
  @@map("ugc_video_submissions")
}

// Append-only audit trail of every video swap and status transition.
// No cascade delete: history survives even if a submission were ever removed.
model UgcVideoHistory {
  id          String     @id @default(uuid())
  ugcVideoId  String
  oldVideoUrl String?
  newVideoUrl String?
  oldStatus   UgcStatus?
  newStatus   UgcStatus?
  action      String // SUBMIT | REPLACE | APPROVE | REJECT | PAUSE | RESUME
  actorId     String?
  actorType   String // AFFILIATE | ADMIN | SYSTEM
  reason      String?
  createdAt   DateTime   @default(now())

  submission UgcVideoSubmission @relation(fields: [ugcVideoId], references: [id], onDelete: Restrict)

  @@index([ugcVideoId])
  @@index([createdAt])
  @@map("ugc_video_history")
}

// Immutable UGC earnings ledger. Monetary fields use Decimal(18,2) (NUMERIC) —
// all UGC money math is Decimal-safe server-side. commissionPerSale is snapshotted
// at generation time so a later settings change never alters historical earnings.
// idempotencyKey = "ugcVideoId:generationPeriod" (unique) is the final duplicate
// guard behind the engine's advisory lock.
model UgcEarning {
  id                String   @id @default(uuid())
  affiliateId       String
  ugcVideoId        String
  productId         String
  generatedSales    Int
  commissionPerSale Decimal  @db.Decimal(18, 2)
  amount            Decimal  @db.Decimal(18, 2)
  generationDate    DateTime // day bucket — aggregate-ready
  generationPeriod  String // uniquely identifies the configured earning interval
  idempotencyKey    String   @unique
  status            String   @default("available")
  createdAt         DateTime @default(now())

  submission UgcVideoSubmission @relation(fields: [ugcVideoId], references: [id], onDelete: Restrict)

  @@index([affiliateId])
  @@index([ugcVideoId])
  @@index([generationPeriod])
  @@index([generationDate])
  @@index([createdAt])
  @@map("ugc_earnings")
}

/// One simulated-sales DAILY TARGET per RUNNING video per business day.
/// The engine picks `dailyTarget` once (random in [minGeneratedSales, maxGeneratedSales])
/// and tracks `generatedToday` as individual simulated sales are emitted (one UgcEarning
/// each). `generationDate` is the business-day bucket (TZ-local midnight instant, same TZ
/// as the earnings ledger). No pre-scheduled sale rows: pacing is derived from
/// `generatedToday` + the ledger, so it is restart-safe. Additive — never touches UgcEarning.
model UgcDailyTarget {
  id             String   @id @default(uuid())
  ugcVideoId     String
  affiliateId    String
  generationDate DateTime // business-day bucket (TZ-local midnight instant)
  businessDate   String   // "YYYY-MM-DD" in the configured timezone (idempotency + audit)
  timezone       String   // timezone in effect when the target was created
  dailyTarget    Int
  generatedToday Int      @default(0)
  completed      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  submission UgcVideoSubmission @relation(fields: [ugcVideoId], references: [id], onDelete: Restrict)

  @@unique([ugcVideoId, generationDate])
  @@index([affiliateId])
  @@index([generationDate])
  @@index([completed])
  @@map("ugc_daily_targets")
}

/// Append-only audit trail of UGC settings changes.
/// `changes` is a JSON array of { key, from, to }. `earningsAffecting` flags a
/// change to a key that influences money generation (commission, generation
/// bounds, engine flag, …) so those edits can be reviewed independently.
/// Written best-effort: a failure here must NEVER block saving settings.
model UgcSettingsHistory {
  id                String   @id @default(uuid())
  actorId           String?
  actorType         String   @default("ADMIN")
  changes           Json
  earningsAffecting Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([earningsAffecting])
  @@map("ugc_settings_history")
}

/// Admin-facing notifications (currently: a new UGC submission awaiting review).
/// Deliberately generic so other admin events can reuse it. No FK to the UGC
/// submission: notifications must survive independently of the entity lifecycle.
model AdminNotification {
  id        String   @id @default(uuid())
  type      String
  message   String
  entityId  String?
  read      Boolean  @default(false)
  /// Deterministic dedup key: `ugc:{submissionId}:{historyId}:{eventType}:admin`.
  eventKey  String?  @unique
  createdAt DateTime @default(now())

  @@index([read])
  @@index([type])
  @@index([createdAt])
  @@map("admin_notifications")
}
